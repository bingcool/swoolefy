{
    "name": "bingcool/swoolefy",
    "description": "swoolefy is a HV Framework based on swoole extension, for everyone use it easily!",
    "keywords": [
        "swoolefy",
        "swoole",
        "php",
        "auto relaod",
        "monitor"
    ],
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "bingcool",
            "email": "2437667702@qq.com",
            "role": "Engineer of php"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php" : "^8.4",
        "ext-swoole" : ">=6.1",
        "ext-json": "*",
        "ext-curl":"*",
        "psr/log" : "*",
        "ext-pcntl" : "*",
        "ext-posix" : "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-sockets": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "dragonmantank/cron-expression": "~3.6.0",
        "vlucas/phpdotenv": "~5.6",
        "symfony/console": "~7.4",
        "symfony/translation": "~7.4",
        "symfony/yaml": "~7.4",
        "zircote/swagger-php": "~4.8.0",
        "doctrine/collections": "~3.0",
        "php-standard-library/php-standard-library": "^6.2",
        "guzzlehttp/guzzle": "~7.9",
        "neuron-core/neuron-ai": "^3.15",
        "symfony/expression-language": "~7.4",
        "bingcool/library": "dev-library-6.x",
        "mathsgod/milvus-client-php": "^2.1",
        "neuron-core/php-vector": "^1.1",
        "neuron-core/router": "^1.2"
    },
    "autoload": {
        "files": ["src/Constants.php","src/Core/Func/function.php"],
        "psr-4": {
            "Swoolefy\\": "src/",
            "Test\\": "Test/"
        }
    },
    "require-dev": {
        "kwn/php-rdkafka-stubs": "dev-master",
        "swoole/ide-helper": "dev-master",
        "viest/php-ext-xlswriter-ide-helper": "dev-master"
    },
    "scripts": {
        "test:workflow": [
            "@php src/Support/Workflow/Tests/WorkflowPhase1Test.php",
            "@php src/Support/Workflow/Tests/WorkflowPhase2Test.php",
            "@php src/Support/Workflow/Tests/WorkflowPhase3Test.php",
            "@php src/Support/Workflow/Tests/WorkflowPhase4Test.php",
            "@php src/Support/Workflow/Tests/WorkflowIntegrationTest.php",
            "@php src/Support/Workflow/Tests/WorkflowRunStoreTest.php",
            "@php src/Support/Workflow/Tests/WorkflowHitlAuthTest.php",
            "@php src/Support/Workflow/Tests/WorkflowPluginMemoryTest.php"
        ],
        "test:outdoor-workflow": "@php Test/Module/Outdoor/Tests/OutdoorWorkflowModuleTest.php",
        "test:order-workflow": "@php Test/Module/Order/Tests/OrderWorkflowModuleTest.php",
        "test:research-workflow": "@php Test/Module/Research/Tests/ResearchWorkflowModuleTest.php",
        "test:rag-workflow": "@php Test/Module/Rag/Tests/RagWorkflowModuleTest.php",
        "test:contract-workflow": "@php Test/Module/Contract/Tests/ContractWorkflowModuleTest.php",
        "test:knowledge-workflow": "@php Test/Module/Knowledge/Tests/KnowledgeWorkflowModuleTest.php",
        "test:workflow-federation": "@php Test/Module/Workflow/Tests/WorkflowFederationTest.php",
        "test:module-workflows": [
            "@test:order-workflow",
            "@test:outdoor-workflow",
            "@test:research-workflow",
            "@test:rag-workflow",
            "@test:contract-workflow",
            "@test:knowledge-workflow",
            "@test:workflow-federation"
        ],
        "test:agent": "@php src/Support/Agent/Tests/AgentModuleTest.php",
        "test:ai": "@php src/Support/AI/Tests/AIModuleTest.php",
        "test:mcp": "@php src/Support/Mcp/Tests/McpModuleTest.php",
        "test:capability": "@php src/Support/CapabilityCenter/Tests/CapabilityCenterTest.php",
        "test:job": [
            "@php src/Support/Job/Tests/JobPhase1Test.php",
            "@php src/Support/Job/Tests/JobPhase2Test.php"
        ],
        "test:document-ocr": "@php src/Support/DocumentOcr/Tests/DocumentOcrTest.php",
        "test:neuron": "@php src/Support/Neuron/Tests/NeuronModuleTest.php",
        "test:rag": "@php src/Support/Rag/Tests/RagModuleTest.php",
        "test:phase-a": "@php src/Support/Tests/PhaseAProductionTest.php",
        "test:application-config": "@php src/Support/Tests/ApplicationConfigTest.php",
        "test:support-log": "@php src/Support/Tests/SupportLogIntegrationTest.php",
        "test:phase-b": "@php src/Support/Tests/PhaseBProductionTest.php",
        "test:phase-c": "@php src/Support/Tests/PhaseCProductionTest.php",
        "test:phase-d": "@php src/Support/Tests/PhaseDTenantIsolationTest.php",
        "test:support": [
            "@test:agent",
            "@test:ai",
            "@test:mcp",
            "@test:capability",
            "@test:job",
            "@test:document-ocr",
            "@test:neuron",
            "@test:rag",
            "@test:phase-a",
            "@test:application-config",
            "@test:support-log",
            "@test:phase-b",
            "@test:phase-c",
            "@test:phase-d",
            "@test:workflow"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "tbachert/spi": false
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../library"
        }
    ]
}
