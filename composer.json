{
    "name": "bingcool/swoolefy",
    "description": "swoolefy is a HV Framework based on swoole extension, for everyone use it easily!",
    "keywords": [
        "swoolefy",
        "swoole",
        "php",
        "auto relaod",
        "monitor"
    ],
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "bingcool",
            "email": "2437667702@qq.com",
            "role": "Engineer of php"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "ext-swoole": ">=6.1",
        "ext-json": "*",
        "ext-curl": "*",
        "psr/log": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-sockets": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "dragonmantank/cron-expression": "~3.6.0",
        "vlucas/phpdotenv": "~5.6",
        "symfony/console": "~7.4",
        "symfony/translation": "~7.4",
        "symfony/yaml": "~7.4",
        "zircote/swagger-php": "~4.8.0",
        "doctrine/collections": "~3.0",
        "php-standard-library/php-standard-library": "^6.2",
        "guzzlehttp/guzzle": "~7.9",
        "neuron-core/neuron-ai": "^3.15",
        "symfony/expression-language": "~7.4",
        "bingcool/library": "dev-library-6.x",
        "mathsgod/milvus-client-php": "^2.1",
        "neuron-core/php-vector": "^1.1",
        "neuron-core/router": "^1.2"
    },
    "autoload": {
        "files": [
            "src/Constants.php",
            "src/Core/Func/function.php"
        ],
        "psr-4": {
            "Swoolefy\\": "src/"
        }
    },
    "autoload-dev": {
        "files": [
            "PhpUintTest/register_dev_autoload.php"
        ]
    },
    "require-dev": {
        "kwn/php-rdkafka-stubs": "dev-master",
        "swoole/ide-helper": "dev-master",
        "viest/php-ext-xlswriter-ide-helper": "dev-master",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit --testsuite unit,coroutine",
        "test:unit": "phpunit --testsuite unit",
        "test:coroutine": "phpunit --testsuite coroutine",
        "test:http": "phpunit --testsuite http",
        "test:http:ci": "SWOOLEFY_HTTP_AUTO_START=1 SWOOLEFY_HTTP_SKIP_IF_DOWN=0 phpunit --testsuite http",
        "test:websocket": "phpunit --testsuite websocket",
        "test:coverage": "phpunit --testsuite unit,coroutine --coverage-text",
        "test:workflow": [
            "@php vendor/bin/phpunit --testsuite unit --filter WorkflowPhase1Test",
            "@php vendor/bin/phpunit --testsuite unit --filter WorkflowPhase2Test",
            "@php vendor/bin/phpunit --testsuite unit --filter WorkflowPhase3Test",
            "@php vendor/bin/phpunit --testsuite unit --filter WorkflowPhase4Test",
            "@php vendor/bin/phpunit --testsuite unit --filter WorkflowIntegrationTest",
            "@php vendor/bin/phpunit --testsuite unit --filter WorkflowRunStoreTest",
            "@php vendor/bin/phpunit --testsuite unit --filter WorkflowHitlAuthTest",
            "@php vendor/bin/phpunit --testsuite unit --filter WorkflowPluginMemoryTest"
        ],
        "test:outdoor-workflow": "@php vendor/bin/phpunit --testsuite unit --filter OutdoorWorkflowModuleTest",
        "test:order-workflow": "@php vendor/bin/phpunit --testsuite unit --filter OrderWorkflowModuleTest",
        "test:research-workflow": "@php vendor/bin/phpunit --testsuite unit --filter ResearchWorkflowModuleTest",
        "test:rag-workflow": "@php vendor/bin/phpunit --testsuite unit --filter RagWorkflowModuleTest",
        "test:contract-workflow": "@php vendor/bin/phpunit --testsuite unit --filter ContractWorkflowModuleTest",
        "test:knowledge-workflow": "@php vendor/bin/phpunit --testsuite unit --filter KnowledgeWorkflowModuleTest",
        "test:workflow-federation": "@php vendor/bin/phpunit --testsuite unit --filter WorkflowFederationTest",
        "test:module-workflows": [
            "@test:order-workflow",
            "@test:outdoor-workflow",
            "@test:research-workflow",
            "@test:rag-workflow",
            "@test:contract-workflow",
            "@test:knowledge-workflow",
            "@test:workflow-federation"
        ],
        "test:agent": "@php vendor/bin/phpunit --testsuite unit --filter AgentModuleTest",
        "test:ai": "@php vendor/bin/phpunit --testsuite unit --filter AIModuleTest",
        "test:mcp": "@php vendor/bin/phpunit --testsuite unit --filter McpModuleTest",
        "test:capability": "@php vendor/bin/phpunit --testsuite unit --filter CapabilityCenterTest",
        "test:job": [
            "@php vendor/bin/phpunit --testsuite unit --filter JobPhase1Test",
            "@php vendor/bin/phpunit --testsuite unit --filter JobPhase2Test"
        ],
        "test:mqtt": [
            "@php vendor/bin/phpunit --testsuite unit --filter MqttModuleTest",
            "@php vendor/bin/phpunit --testsuite unit --filter MqttGracefulShutdownTest"
        ],
        "test:document-ocr": "@php vendor/bin/phpunit --testsuite unit --filter DocumentOcrTest",
        "test:neuron": "@php vendor/bin/phpunit --testsuite unit --filter NeuronModuleTest",
        "test:rag": "@php vendor/bin/phpunit --testsuite unit --filter RagModuleTest",
        "test:phase-a": "@php vendor/bin/phpunit --testsuite unit --filter PhaseAProductionTest",
        "test:auth": [
            "@php vendor/bin/phpunit --testsuite unit --filter AuthModuleTest",
            "@php vendor/bin/phpunit --testsuite coroutine --filter AuthContextGoAppTest"
        ],
        "test:application-config": "@php vendor/bin/phpunit --testsuite unit --filter ApplicationConfigTest",
        "test:support-log": "@php vendor/bin/phpunit --testsuite unit --filter SupportLogIntegrationTest",
        "test:phase-b": "@php vendor/bin/phpunit --testsuite unit --filter PhaseBProductionTest",
        "test:phase-c": "@php vendor/bin/phpunit --testsuite coroutine --filter PhaseCProductionTest",
        "test:phase-d": "@php vendor/bin/phpunit --testsuite unit --filter PhaseDTenantIsolationTest",
        "test:support": [
            "@test:agent",
            "@test:ai",
            "@test:mcp",
            "@test:capability",
            "@test:job",
            "@test:document-ocr",
            "@test:neuron",
            "@test:rag",
            "@test:phase-a",
            "@test:auth",
            "@test:application-config",
            "@test:support-log",
            "@test:phase-b",
            "@test:phase-c",
            "@test:phase-d",
            "@test:workflow"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "tbachert/spi": false
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../library"
        }
    ]
}
