(function () {
    $application = new Application();
    $application->addCommand(new CreateCmd());
    $application->addCommand(new StartCmd());
    $application->addCommand(new StopCmd());
    $application->addCommand(new StatusCmd());
    $application->addCommand(new ReloadCmd());
    $application->addCommand(new SendCmd());
    $application->addCommand(new MonitorCmd());
    $application->addCommand(new RestartCmd());
    //showLogo();
    $application->run();
})();
