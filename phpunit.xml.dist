<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="PHPUintTest/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="false">
    <!-- 分层靠 suite；横切 redis/db/slow 用 group exclude。勿 exclude http/websocket。 -->
    <testsuites>
        <testsuite name="unit">
            <!-- 不含 Unit/Controller：curl 黄金路径归 http suite -->
            <directory>PHPUintTest/Unit/Support</directory>
            <directory>PHPUintTest/Unit/Module</directory>
            <directory>PHPUintTest/Unit/Mqtt</directory>
            <directory>PHPUintTest/Unit/Http</directory>
            <directory>PHPUintTest/Unit/Library</directory>
            <directory>PHPUintTest/Unit/Script</directory>
            <directory>PHPUintTest/Unit/Cmd</directory>
            <directory>PHPUintTest/Unit/Rpc</directory>
            <directory>PHPUintTest/Unit/Worker</directory>
            <directory>PHPUintTest/Unit/Core</directory>
            <!-- 9.4：Util 单测此前未纳入 unit suite -->
            <directory>PHPUintTest/Unit/Util</directory>
        </testsuite>
        <testsuite name="coroutine">
            <directory>PHPUintTest/Coroutine</directory>
        </testsuite>
        <testsuite name="http">
            <directory>PHPUintTest/Http</directory>
            <directory>PHPUintTest/Unit/Controller</directory>
        </testsuite>
        <testsuite name="websocket">
            <directory>PHPUintTest/Websocket</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>redis</group>
            <group>db</group>
            <group>slow</group>
            <group>smoke</group>
        </exclude>
    </groups>
    <php>
        <env name="SWOOLEFY_CLI_ENV" value="dev"/>
        <env name="SWOOLEFY_HTTP_SKIP_IF_DOWN" value="1"/>
        <env name="WS_SMOKE_SKIP_IF_DOWN" value="1"/>
    </php>
    <source>
        <include>
            <directory suffix=".php">src/Support</directory>
            <directory suffix=".php">src/Http</directory>
            <directory suffix=".php">src/Core</directory>
            <directory suffix=".php">src/Websocket</directory>
        </include>
    </source>
</phpunit>
