# 是否开启异常捕获日志脱敏password,token等,生产环境建议开启
ENABLE_LOG_SANITIZE=false

#cron service debug配置,默认开启
CRON_DEBUG=true

# 内部跨环境可访问的服务 URL。服务注册时会写入 Nacos metadata 的 `inner_external_base_uri`
INNER_EXTERNAL_BASE_URI='http://127.0.0.1:9501'

# mysqL配置
DB_HOST_NAME=192.168.1.105
DB_HOST_DATABASE=bingcool
DB_USER_NAME=root
DB_PASSWORD=123456
DB_HOST_PORT=3306

# redis配置
REDIS_HOST=192.168.1.105
REDIS_PORT=6379
REDIS_DB=1

# RabbitMQ（dc.php amqp_connection）
AMQP_HOST=192.168.1.105
AMQP_PORT=5672
AMQP_USER=rabbitmq
AMQP_PASSWORD=123456
AMQP_VHOST=my_vhost

# Kafka（dc.php kafka_broker_list，多个 broker 用英文逗号分隔）
KAFKA_BROKER_LIST=192.168.23.53:9092

# RocketMQ Proxy（Sidecar 进程的 gRPC 地址，host:port）
SIDECAR_ROCKETMQ_ENABLE=false
SIDECAR_ROCKETMQ_PROXY_ENDPOINT=127.0.0.1:8081
SIDECAR_ROCKETMQ_ACCESS_KEY=
SIDECAR_ROCKETMQ_SECRET_KEY=

# Sidecar 公共数值。某一项没写这些键时，用这里的值。
SIDECAR_MAX_FRAME_BYTES=16777216
SIDECAR_DEFAULT_TIMEOUT_MS=3000
SIDECAR_MAX_TIMEOUT_MS=30000
SIDECAR_MAX_INFLIGHT=128
SIDECAR_SHUTDOWN_GRACE_MS=5000

HTTP_HOST=127.0.0.1

# website
WEB_SITE_HOST='http://127.0.0.1/'


POSTGRES_HOST=192.168.25.13
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# OpenTelemetry
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_RESOURCE_SERVICE_NAME='swoolefy-service'
OTEL_TRACING_NAME='swoolefy-http-request'
# 阿里云腾讯云的Authentication token
OTEL_EXPORTER_OTLP_AUTHENTICATION_TOKEN=''
OTEL_EXPORTER_OTLP_ENDPOINT='http://192.168.1.105:4318'
OTEL_EXPORT_TIMEOUT=30
OTEL_MAX_QUEUE_SIZE=512
OTEL_SAMPLER_TYPE=always_on
# 启用批量提交span
OTEL_SAMPLER_BATCH_SPAN_ENABLED=true
OTEL_SAMPLER_TRACE_ID_RATIO=0.2
# 启用GUZZLE_HTTP自动跟踪
OTEL_INSTRUMENTATION_GUZZLE_ENABLED=true
# 同一个协程中最多允许记录curl请求数，防止业务上的循环请求的记录，默认100
OTEL_INSTRUMENTATION_GUZZLE_MAX_TRACE_SPANS_NUM=50



# 跨域配置
CORS_ALLOWED_ORIGINS_PATTERNS=

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash